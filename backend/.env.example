# Postgres connection string from your managed provider (Supabase, Neon, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Google AI Studio / Vertex API key for Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Slack Incoming Webhook URL for alerts
SLACK_WEBHOOK_URL=

# Optional: Grafana Cloud annotation API (leave blank to skip)
GRAFANA_URL=https://yourstack.grafana.net
GRAFANA_API_KEY=
